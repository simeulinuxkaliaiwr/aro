# aro example config
# copy this to ~/.config/aro/config
#
# everything is optional. missing keys just use the defaults from src/theme.h.
# colors accept 0xRRGGBBAA, #rrggbbaa, or just rrggbbaa. alpha is optional (defaults to ff).

mod = super                 # or: alt (useful if you're running nested inside another compositor)
focus_follows_mouse = false

# prompt before quitting (default bind is super+shift+e).
# kills all open windows if you say yes.
confirm_quit = true

# manual: new windows split next to the focused one (i3 style).
# dwindle: splits follow the longer axis of the frame, spiraling automatically (Hyprland style).
# mod+v / mod+s will temporarily override either mode for the next window.
layout = dwindle

# workspaces are created on demand. this just sets how many pills the bar
# shows by default so it isn't empty on startup.
workspaces = 8

# === keyboard ===
# falls back to XKB_DEFAULT_* env vars if unset.
keyboard_layout = us
# keyboard_variant = nodeadkeys
# keyboard_options = compose:ralt
# keyboard_model =
# keyboard_rules =

# === monitors ===
# one block per screen. the name is a glob matched against the connector
# name (e.g. HDMI-A-1) and the "make model serial" string.
# check the logs when a screen plugs in to see what to match against:
#   output: name="HDMI-A-1" desc="Dell Inc. DELL U2419H 7ABC123"
monitor * {
    enabled = auto          # defaults to on
    scale = auto            # 2x for >192 DPI, 1x otherwise
    position = auto         # places it to the right of existing screens
    transform = auto        # normal orientation
    adaptive_sync = auto    # defaults to off
}

# monitor "Dell Inc. DELL U2419H*" {
#     mode = 1920x1080@60     # @Hz is optional. @60 will match 59.95Hz etc.
#     position = 1536,0       # layout pixels (after scaling is applied)
#     scale = 1.25
#     transform = normal      # 90, 180, 270, flipped, etc.
#     adaptive_sync = false
#     enabled = true
# }
#
# note: `auto` is not the same as omitting the key.
# omitting a key means "leave it alone on reload" (so wlr-randr/kanshi
# changes don't get overwritten). `auto` explicitly resets it to the default.
#
# if multiple blocks match, they all apply. the bottom-most one wins for conflicts.
# aro won't let you turn off your only active monitor via config.

# === spacing ===
gaps = 9                    # between tiled windows
outer_gaps = 9              # between the layout and screen edges
border = 2
radius = 5                  # requires building with -Deffects=true
min_size = 80               # minimum size for a tiled window
header_height = 26          # set to 0 to hide window titles
# always: draw our header even if the app draws its own (results in two titlebars).
# auto: hide our header if the app uses CSD.
header = always
bar_height = 30
bar_padding = 12
text_padding = 10

# floating windows use these minimums instead of min_size,
# otherwise tiny dialogs could shrink to 80x80.
float_min_width = 240
float_min_height = 120
float_scale = 0.5           # default size for floating windows (fraction of screen)

# === colors ===
# the design uses a single accent color, only applied to the focused window.
background = 0x0c0f13ff     # visible in the gaps
frame = 0x12161dff
frame_focus = 0x161b23ff
border_color = 0x222a35ff   # unfocused border
accent = 0xe6a54bff
accent_soft = 0xe6a54b4d    # subtle 1px inner ring
text = 0xd7dfe9ff
text_dim = 0x6b7788ff
bar_color = 0x0a0d11ff
urgent = 0xc0566bff
drop_fill = 0xe6a54b1f      # drag-and-drop preview background
drop_line = 0xe6a54bcc

# built-in toast notifications (not a real notification daemon)
notify_color = 0x12161deb
notify_ms = 6000
notify_max_width = 520
scrim_color = 0x0c0f13b3    # background dimming for the exit prompt

font = Sans 10
font_small = Sans 9

anim_ms = 340               # standard window animations
fullscreen_anim_ms = 220    # no spring overshoot for fullscreen
focus_anim_ms = 160
drop_anim_ms = 160

# workspace switches slide the old workspace out and the new one in.
# a higher workspace number comes in from the right (or from below).
# with two monitors the windows briefly cross onto the other screen.
workspace_slide = horizontal    # horizontal | vertical | off
workspace_slide_ms = 220        # no overshoot; 0 is the same as off
open_scale = 0.88           # starting scale for new windows

# === window switcher (mod+tab) ===
# windows in recently-used order, across every workspace and screen.
# hold mod and tap tab to walk the list; let go of mod to switch.
switcher_delay_ms = 150         # a quick tap swaps windows without showing the card
switcher_debounce_ms = 750      # how long a window needs focus to count as "used"
                                # (typing into it counts immediately)
switcher_preview_height = 260   # capped at half the screen; with many
                                # windows previews shrink (to 60% at most)
                                # so the row fits the screen width

# === pointer ===
drag_threshold = 12         # pixels to drag before a tiled window detaches
resize_zone = 8             # edge grab area in pixels
resize_step = 0.04          # resize amount per keypress

# === startup ===
# saving this file reloads it instantly. syntax errors will pop up a toast.
#
# exec        runs once on startup.
# exec_always runs on startup AND on every config reload (doesn't kill old instances).
#
# exec = swaybg -i ~/wallpaper.png
# exec_always = pkill waybar; waybar

# fix for xdg-desktop-portal on systemd:
# portals need to know which compositor to talk to, otherwise things like
# GTK file pickers or screen sharing will hang indefinitely.
# uncomment these if your portals aren't working properly.
# exec = systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP
# exec = systemctl --user restart xdg-desktop-portal xdg-desktop-portal-gtk

# === window rules ===
# rule = <match>... <action>...
#
# match:   app_id:<pattern>   title:<pattern>   type:<pattern>
#          supports globs (* and ?). case-insensitive.
#          wrap patterns with spaces in quotes: title:"Open File".
#          all matches on a line must be true. you need at least one match.
#          (app_id maps to WM_CLASS for X11 windows).
#
#          type is the window type: normal, dialog, splash, utility,
#          toolbar, menu, dropdown-menu, popup-menu, tooltip, notification,
#          combo, dnd, dock, desktop. X11 windows report their own; Wayland
#          windows are only ever normal, or dialog when they have a parent.
#          dialog, utility, toolbar and splash already float by default.
#
# action:  float | tile | fullscreen | workspace <1..32>
#          use `tile` to force tiling on dialogs, or `float` to force floating.
#
# rules apply top-to-bottom. if multiple rules set the same property, the last one wins.
# rules are evaluated on window map, title change, app_id change, and config
# reload. only what changed is re-applied.
#
# tip: check the logs when a window opens to find its app_id and type:
#   map: app_id="org.gnome.Calculator" title="Calculator" type=normal
#
# rule = app_id:mpv  workspace 3
# rule = app_id:firefox  title:Picture-in-Picture  float
# rule = app_id:org.gnome.Calculator  float
# rule = title:*YouTube*  fullscreen
# rule = type:splash  workspace 1
# rule = type:dialog  app_id:gimp*  tile

# === keybindings ===
# bind = <combo>, <action>[, <argument>]
#
# adding your first `bind` line completely replaces the default keybindings.
#
# actions: spawn <cmd> | close | quit | float | fullscreen
#          focus|move|resize left|right|up|down
#          workspace|sendto 1..32
#          split right|down
#          switch next|prev
bind = mod+Return, spawn, foot
bind = mod+d, spawn, fuzzel
bind = mod+q, close
bind = mod+shift+e, quit
bind = mod+space, float
bind = mod+f, fullscreen
bind = mod+Tab, switch, next
bind = mod+shift+Tab, switch, prev
bind = mod+v, split, right
bind = mod+s, split, down
bind = mod+h, focus, left
bind = mod+j, focus, down
bind = mod+k, focus, up
bind = mod+l, focus, right
bind = mod+shift+h, move, left
bind = mod+shift+j, move, down
bind = mod+shift+k, move, up
bind = mod+shift+l, move, right
bind = mod+ctrl+h, resize, left
bind = mod+ctrl+j, resize, down
bind = mod+ctrl+k, resize, up
bind = mod+ctrl+l, resize, right
bind = mod+1, workspace, 1
bind = mod+2, workspace, 2
bind = mod+3, workspace, 3
bind = mod+4, workspace, 4
bind = mod+shift+1, sendto, 1
bind = mod+shift+2, sendto, 2
bind = mod+shift+3, sendto, 3
bind = mod+shift+4, sendto, 4
